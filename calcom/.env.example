# Cal.com Self-Hosted Environment
# Deploy en Vercel + Supabase (gratis)

# Database (usa la misma Supabase del proyecto principal)
DATABASE_URL=postgresql://postgres:[SUPABASE_DB_PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres

# NextAuth
NEXTAUTH_SECRET=[genera con: openssl rand -base64 32]
NEXTAUTH_URL=https://cal.tu-dominio.com

# Encryption
ENCRYPTION_KEY=[genera con: openssl rand -hex 32]

# Email (usa Resend o Postal self-hosted)
EMAIL_FROM=noreply@cal.tu-dominio.com
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=[RESEND_API_KEY]

# Features
NEXT_PUBLIC_FEATURE_FLAGS="managed-events,workflows,analytics"
NEXT_PUBLIC_DISABLE_SIGNUP=false

# Telemetry
NEXT_TELEMETRY_DISABLED=1

# OAuth (opcional - para Google/Outlook calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Timezone
TZ=America/Bogota