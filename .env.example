# Supabase (gratis: 500MB DB, 1GB storage, 2M auth/mes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Resend (gratis: 3,000 emails/mes) - usado SOLO como fallback si no configuras Zoho SMTP
RESEND_API_KEY=re_xxxxxxxxxxxx
# Remitente. En el plan free usa "onboarding@resend.dev" (envÃ­a solo a tu propio correo).
# Para enviar a cualquier correo, verifica tu dominio y usa algo como "JPV AI <no-reply@tudominio.com>".
RESEND_FROM=onboarding@resend.dev

# ===== Notificaciones multicanal =====
# Correos a los que llegan los contactos del formulario (separados por coma)
NOTIFY_EMAILS=vexania@zohomail.com,tucorreo@gmail.com,tucorreoinstitucional@empresa.edu.co
# Envío desde el buzón Zoho vía SMTP (password de aplicación: Zoho Mail -> Seguridad -> Passwords de aplicación)
ZOHO_SMTP_USER=vexania@zohomail.com
ZOHO_SMTP_PASS=tu-password-de-aplicacion
# Telegram: token del bot (@BotFather) y chat_id al que llegan las notificaciones
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
# Teams: URL del Incoming Webhook del canal (webhook.office.com, sin OAuth)
# O URL del flujo Power Automate (requiere OAuth client-credentials, ver TEAMS_TENANT_ID/CLIENT_ID/CLIENT_SECRET)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# OAuth para flujo Power Automate (solo si TEAMS_WEBHOOK_URL es URL de un flujo):
TEAMS_TENANT_ID=your-tenant-id
TEAMS_CLIENT_ID=your-client-id
TEAMS_CLIENT_SECRET=your-client-secret

# Correo donde llegan los contactos del formulario (legacy, NOTIFY_EMAILS tiene prioridad)
CONTACT_EMAIL=vexania@zohomail.com

# ProtecciÃ³n de los cron endpoints (/api/cron/*). Vercel la envÃ­a como Bearer en la cabecera Authorization.
CRON_SECRET=generate-with-openssl-rand-base64-32

# Opcional: Postal self-hosted (si no usas Resend)
POSTAL_HOST=postal.tu-dominio.com
POSTAL_API_KEY=your-postal-api-key

# Cloudflare (gratis: DNS, CDN, Workers 100k/dÃ­a)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Vercel (gratis: 100GB BW, 100GB-hrs functions)
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-org-id
VERCEL_PROJECT_ID=your-project-id

# Analytics (opcional - PostHog Cloud gratis: 1M eventos/mes)
POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://app.posthog.com

# Error Tracking (opcional - Sentry Cloud gratis: 5k errores/mes)
SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Dominio (Ãºnico costo ~$12/aÃ±o en Namecheap)
DOMAIN=jpv-ai.com

# Cal.com (self-hosted en Vercel + Supabase)
CALCOM_URL=https://cal.tu-dominio.com
CALCOM_API_KEY=your-calcom-api-key

# ===== Pagos Wompi (Nequi / Daviplata) =====
# Obtén credenciales en https://sandbox.wompi.co (pruebas) o https://production.wompi.co (producción)
# WOMPI_ENV: 'sandbox' o 'production'
WOMPI_ENV=sandbox
# Llave pública (pk_...) - se usa en el frontend y para crear transacciones
WOMPI_PUBLIC_KEY=pub_xxxxxxxxxxxx
# Llave privada (prv_...) - SOLO en backend, NUNCA en frontend
WOMPI_PRIVATE_KEY=prv_xxxxxxxxxxxx
# Secreto de integridad (para firmar/verificar webhooks) - configurable en panel de Wompi
WOMPI_INTEGRITY_SECRET=your-integrity-secret

# Configuración de la app
PUBLIC_APP_URL=https://vexania.vercel.app
PUBLIC_APP_NAME="Vexania"
PUBLIC_DEFAULT_TIMEZONE=America/Bogota
# Agendamiento con Cal.com (open-source, gratis, hasta 3+ tipos de reuniÃ³n)
# Tu usuario de Cal.com. Muestra los tipos de reuniÃ³n y tu disponibilidad embebidos.
PUBLIC_CALCOM_USERNAME=vexania
# Enlace manual alternativo (fallback si no se define PUBLIC_CALCOM_USERNAME)
PUBLIC_BOOKING_URL=https://cal.com/vexania
