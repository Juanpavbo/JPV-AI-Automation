# Supabase (gratis: 500MB DB, 1GB storage, 2M auth/mes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Resend (gratis: 3,000 emails/mes)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Correo donde llegan los contactos del formulario
CONTACT_EMAIL=aiyautomation@zohomail.com

# Protección de los cron endpoints (/api/cron/*). Vercel la envía como Bearer en la cabecera Authorization.
CRON_SECRET=generate-with-openssl-rand-base64-32

# Opcional: Postal self-hosted (si no usas Resend)
POSTAL_HOST=postal.tu-dominio.com
POSTAL_API_KEY=your-postal-api-key

# Cloudflare (gratis: DNS, CDN, Workers 100k/día)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Vercel (gratis: 100GB BW, 100GB-hrs functions)
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-org-id
VERCEL_PROJECT_ID=your-project-id

# Analytics (opcional - PostHog Cloud gratis: 1M eventos/mes)
POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://app.posthog.com

# Error Tracking (opcional - Sentry Cloud gratis: 5k errores/mes)
SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Dominio (único costo ~$12/año en Namecheap)
DOMAIN=jpv-ai.com

# Cal.com (self-hosted en Vercel + Supabase)
CALCOM_URL=https://cal.tu-dominio.com
CALCOM_API_KEY=your-calcom-api-key

# Configuración de la app
PUBLIC_APP_URL=https://jpv-ai-automation.vercel.app
PUBLIC_APP_NAME="JPV AI & Automation"
PUBLIC_DEFAULT_TIMEZONE=America/Bogota
# Agendamiento con Cal.com (open-source, gratis, hasta 3+ tipos de reunión)
# Tu usuario de Cal.com (ej: https://cal.com/juanpavbo). Muestra los tipos de reunión y tu disponibilidad embebidos.
PUBLIC_CALCOM_USERNAME=tu-usuario-calcom
# Enlace manual alternativo (fallback si no se define PUBLIC_CALCOM_USERNAME)
PUBLIC_BOOKING_URL=https://cal.com/tu-usuario-calcom