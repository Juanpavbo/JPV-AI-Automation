---
import '../styles/global.css';
import { Calendar, Mail, Linkedin, Menu, X } from 'lucide-preact';
import Chat from '../components/Chat.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Vexania - Transformación veloz y segura: consultoría TI, automatización e inteligencia artificial' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#0a0a0f" />
  <script is:inline>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(() => {});
    }
  </script>
</head>
<body class="antialiased">
  <header class="glass sticky top-0 z-50">
    <nav class="container flex items-center justify-between h-16" aria-label="Navegación principal">
      <a href="/" class="flex flex-col items-start leading-tight" aria-label="Vexania - Inicio">
        <span class="text-xl font-bold text-brand-cyan">Vexania</span>
        <span class="text-[0.6rem] font-medium leading-snug text-brand-pink">Transformación veloz y segura: consultoría TI, automatización e inteligencia artificial</span>
      </a>
      <button class="md:hidden p-2 text-brand-cyan" aria-label="Menú" aria-expanded="false" aria-controls="mobile-menu">
        <Menu id="menu-icon" class="w-6 h-6" />
        <X id="close-icon" class="w-6 h-6 hidden" />
      </button>
      <ul id="mobile-menu" class="hidden md:flex items-center gap-8" role="navigation">
        <li><a href="#inicio" class="text-sm text-gray-400 hover:text-brand-cyan transition-colors">Inicio</a></li>
        <li><a href="#porque" class="text-sm text-gray-400 hover:text-brand-cyan transition-colors">Por qué</a></li>
        <li><a href="#servicios" class="text-sm text-gray-400 hover:text-brand-cyan">Servicios</a></li>
        <li><a href="#about" class="text-sm text-gray-400 hover:text-brand-cyan">Sobre mí</a></li>
        <li><a href="#stack" class="text-sm text-gray-400 hover:text-brand-cyan">Stack</a></li>
        <li><a href="#agendar" class="text-sm text-gray-400 hover:text-brand-cyan">Agendar</a></li>
        <li><a href="#contacto" class="btn btn-primary text-sm">Contactar</a></li>
      </ul>
    </nav>
  </header>
  <main id="main-content">
    <slot />
  </main>
  <footer class="border-t border-brand-border py-12">
    <div class="container text-center text-sm text-gray-500">
      <p class="text-lg font-semibold text-brand-cyan">Vexania</p>
      <p class="mt-2 text-xs text-gray-500 max-w-xl mx-auto">
        Transformación veloz y segura: consultoría TI, automatización e inteligencia artificial.
      </p>
      <p class="mt-3">© 2026 Vexania · Hecho con ⚡ en Bogotá, Colombia</p>
      <div class="flex justify-center gap-6 mt-4">
        <a href="https://www.linkedin.com/company/136065577" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-brand-cyan transition-colors" aria-label="LinkedIn"><Linkedin class="w-5 h-5" /></a>
        <a href="mailto:aiyautomation@zohomail.com" class="text-gray-400 hover:text-brand-cyan transition-colors" aria-label="Email"><Mail class="w-5 h-5" /></a>
        <a href="#agendar" class="text-gray-400 hover:text-brand-cyan transition-colors" aria-label="Calendario"><Calendar class="w-5 h-5" /></a>
      </div>
    </div>
  </footer>
  <Chat />
  <script is:inline>
    const btn = document.querySelector('header button');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    btn?.addEventListener('click', () => {
      const open = menu?.classList.toggle('hidden');
      menuIcon?.classList.toggle('hidden', !open);
      closeIcon?.classList.toggle('hidden', open);
      btn.setAttribute('aria-expanded', String(!open));
    });
  </script>
</body>
</html>