---
const steps = [
  {
    num: '01',
    title: 'Diagnóstico gratis (30 min)',
    desc: 'Identificamos tus procesos repetitivos, medimos cuánto tiempo consumen y estimamos el ahorro potencial. Te entregamos 3 quick-wins priorizados y una hoja de ruta clara. Sin costo, sin compromiso.',
    icon: 'Search',
    color: 'brand'
  },
  {
    num: '02',
    title: 'Diseño de la solución',
    desc: 'Elegimos la tecnología adecuada para cada proceso: RPA, agentes de IA, OCR o integraciones API. Definimos alcance, métricas de éxito y cronograma. Tú apruebas antes de construir.',
    icon: 'PenTool',
    color: 'accent'
  },
  {
    num: '03',
    title: 'Implementación en sprints',
    desc: 'Construimos y probamos los robots en ciclos cortos de 1-2 semanas. Primero liberamos los quick-wins para que veas resultados temprano, y después escalamos al resto.',
    icon: 'Rocket',
    color: 'brand'
  },
  {
    num: '04',
    title: 'Puesta en marcha y soporte',
    desc: 'Capacitamos a tu equipo, documentamos todo y dejamos los robots monitoreados 24/7. Si algo falla, te avisamos y lo corregimos. Planes de soporte mensual disponibles.',
    icon: 'ShieldCheck',
    color: 'accent'
  }
] as const;

const icons = {
  Search: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>',
  PenTool: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>',
  Rocket: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>',
  ShieldCheck: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>'
} as const;

const boxClasses = {
  brand: 'bg-[var(--brand-bg)] border-[var(--brand-border)] text-[var(--brand-dark)]',
  accent: 'bg-[var(--accent-bg)] border-[var(--accent-border)] text-[var(--accent-dark)]'
} as const;
---

<section id="metodologia" class="section-lg relative overflow-hidden" aria-labelledby="metodologia-title">
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/4 right-1/4 w-[400px] h-[400px] bg-[var(--brand)]/5 rounded-full blur-[150px]" />
    <div class="absolute bottom-1/4 left-1/4 w-[300px] h-[300px] bg-[var(--accent)]/5 rounded-full blur-[120px]" />
  </div>

  <div class="container relative z-10">
    <header class="text-center mb-16 lg:mb-20 reveal slide-up">
      <span class="section-label">Metodología</span>
      <h2 id="metodologia-title" class="display-md text-[var(--text)] mb-6">De la idea al robot funcionando en 4 pasos</h2>
      <p class="body-lg max-w-2xl mx-auto">Un proceso claro, transparente y sin letra chica. Tú decides en cada paso y siempre sabes cuánto cuesta y cuánto vas a ahorrar.</p>
    </header>

    <ol class="grid lg:grid-cols-4 gap-6">
      {steps.map((s, i) => (
        <li class="relative">
          {i < steps.length - 1 && (
            <span class="hidden lg:block absolute top-10 left-full w-8 border-t-2 border-dashed border-[var(--border-strong)] -translate-x-4" aria-hidden="true" />
          )}
          <article class="card card-elevated h-full reveal slide-up" style="animation-delay: {100 + i * 150}ms;">
            <div class="flex items-center justify-between mb-6">
              <span class={`w-16 h-16 rounded-2xl border flex items-center justify-center ${boxClasses[s.color]}`} set:html={icons[s.icon]} />
              <span class="text-4xl font-extrabold text-[var(--text-muted)] opacity-40" aria-hidden="true">{s.num}</span>
            </div>
            <h3 class="heading-md text-[var(--text)] mb-3">{s.title}</h3>
            <p class="body-sm text-[var(--text-secondary)]">{s.desc}</p>
          </article>
        </li>
      ))}
    </ol>

    <div class="text-center mt-16 lg:mt-20 reveal slide-up">
      <div class="p-8 lg:p-12 bg-[var(--brand)] rounded-2xl max-w-3xl mx-auto text-white">
        <h3 class="display-md text-white mb-4">Empieza hoy con tu diagnóstico gratis</h3>
        <p class="body-lg text-[var(--brand-light)] mb-8 max-w-xl mx-auto">30 minutos, sin compromiso. Saldrás con una lista clara de procesos que puedes automatizar y cuánto puedes ahorrar.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="#contacto" class="btn btn-lg" style="background: white; color: var(--brand); border: 2px solid white;">Agendar diagnóstico gratis</a>
          <a href="#procesos" class="btn btn-lg" style="background: transparent; border: 2px solid white; color: white;">Probar el cotizador</a>
        </div>
      </div>
    </div>
  </div>
</section>