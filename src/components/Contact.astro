---
import Chat from './Chat.astro';

const interests = [
  { value: 'automatizacion', label: 'Automatización de procesos' },
  { value: 'bi', label: 'Analítica / Power BI / Tableros' },
  { value: 'ia', label: 'Agentes de IA / LLMs' },
  { value: 'lowcode', label: 'Low-Code / No-Code' },
  { value: 'consultoria', label: 'Consultoría general' },
  { value: 'personal', label: 'Optimización personal / laboral' },
  { value: 'otro', label: 'Otro' }
] as const;
---

<section id="contacto" class="py-20 md:py-28">
  <div class="container">
    <div class="section-label mb-3 inline-block text-center mx-auto">Contacto</div>
    <h2 class="section-title text-3xl md:text-4xl font-bold text-center mb-4">Trabajemos juntos</h2>
    <p class="section-desc text-gray-400 max-w-2xl mx-auto mb-12 text-center">
      ¿Tienes un proceso que automatizar, un tablero que construir o una idea que necesita tecnología para despegar? Cuéntame.
    </p>

    <div class="contact-grid grid lg:grid-cols-2 gap-12">
      <form class="contact-form p-8 rounded-2xl" action="/api/contact" method="POST" style="background: #12121a; border: 1px solid rgba(0,212,255,.1);">
        <input type="hidden" name="form-name" value="contacto" />
        <p style="display:none;"><input name="bot-field" /></p>

        <div class="form-row grid grid-cols-1 md:grid-cols-2 gap-4 mb-5">
          <div class="form-group">
            <label for="nombre" class="block text-sm text-gray-500 mb-1 font-medium">Nombre</label>
            <input type="text" id="nombre" name="nombre" required placeholder="Tu nombre"
              class="w-full px-4 py-3 rounded-lg border focus:border-brand-cyan focus:outline-none transition-colors"
              style="background: #0e0e15; border-color: rgba(0,212,255,.15); color: #e0e0e0;" />
          </div>
          <div class="form-group">
            <label for="email" class="block text-sm text-gray-500 mb-1 font-medium">Correo electrónico</label>
            <input type="email" id="email" name="email" required placeholder="tu@correo.com"
              class="w-full px-4 py-3 rounded-lg border focus:border-brand-cyan focus:outline-none transition-colors"
              style="background: #0e0e15; border-color: rgba(0,212,255,.15); color: #e0e0e0;" />
          </div>
        </div>

        <div class="form-group mb-5">
          <label for="interes" class="block text-sm text-gray-500 mb-1 font-medium">¿Qué necesitas?</label>
          <select id="interes" name="interes" class="w-full px-4 py-3 rounded-lg border focus:border-brand-cyan focus:outline-none transition-colors cursor-pointer"
            style="background: #0e0e15; border-color: rgba(0,212,255,.15); color: #e0e0e0;">
            <option value="">Selecciona una opción</option>
            {interests.map((opt) => <option value={opt.value}>{opt.label}</option>)}
          </select>
        </div>

        <div class="form-group mb-6">
          <label for="mensaje" class="block text-sm text-gray-500 mb-1 font-medium">Cuéntame más</label>
          <textarea id="mensaje" name="mensaje" required rows="5" placeholder="Describe tu situación, lo que necesitas o la idea que tienes..."
            class="w-full px-4 py-3 rounded-lg border focus:border-brand-cyan focus:outline-none transition-colors resize-y min-h-[120px] font-inherit"
            style="background: #0e0e15; border-color: rgba(0,212,255,.15); color: #e0e0e0;"></textarea>
        </div>

        <button type="submit" class="btn btn-primary w-full justify-center">Enviar mensaje →</button>
      </form>

      <div>
        <div style="background: #12121a; border: 1px solid rgba(0,212,255,.1); border-radius: 1rem; padding: 2rem; height: 100%;">
          <h3 class="text-lg font-semibold mb-4">También puedes</h3>
          <div class="flex flex-col gap-4">
            <a href="https://www.linkedin.com/company/jpv-ai-automation" target="_blank" rel="noopener noreferrer" class="contact-card flex items-center gap-3 p-4 rounded-xl transition-all duration-200" style="background: #12121a; border: 1px solid rgba(0,212,255,.12); text-decoration: none; color: #e0e0e0;">
              <span class="icon text-xl" style="color: #00d4ff;">💼</span>
              <span>Escribirme por LinkedIn</span>
            </a>
            <a href="mailto:aiyautomation@zohomail.com" class="contact-card flex items-center gap-3 p-4 rounded-xl transition-all duration-200" style="background: #12121a; border: 1px solid rgba(0,212,255,.12); text-decoration: none; color: #e0e0e0;">
              <span class="icon text-xl" style="color: #00d4ff;">✉️</span>
              <span>aiyautomation@zohomail.com</span>
            </a>
            <a href="#agendar" class="btn btn-accent justify-center mt-2">Agendar videollamada →</a>
          </div>
        </div>
        <div class="mt-6">
          <Chat variant="inline" />
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .contact-card:hover { border-color: #00d4ff; transform: translateY(-2px); }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: #00d4ff; }
  .form-group select option { background: #12121a; color: #e0e0e0; }
</style>