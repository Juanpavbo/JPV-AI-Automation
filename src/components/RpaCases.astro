---
const cases = [
  {
    id: 'retail',
    industry: 'Retail & Comercio',
    title: 'Conciliación y cobranza 100% automáticas',
    desc: 'Cadena con 5 tiendas: 300+ pagos/día entre Nequi, Daviplata y bancos. Antes 3h/día conciliando a mano y cobranza con llamadas. Ahora todo se valida solo.',
    savings: '~90h/mes',
    metric: '3h → 0 min',
    robo: '0 errores',
    tech: ['RPA', 'Nequi/Daviplata', 'n8n', 'Power BI'],
    color: 'brand'
  },
  {
    id: 'contabilidad',
    industry: 'Contabilidad & Finanzas',
    title: 'OCR de facturas entrantes + contabilización',
    desc: 'Estudio contable que recibía 500+ facturas/mes. Los robots leen cada factura, extraen datos y las contabilizan en minutos, con trazabilidad completa.',
    savings: '~60h/mes',
    metric: '12 min → 2 min',
    robo: '100% trazabilidad',
    tech: ['OCR', 'RPA', 'SAP/Contabilidad', 'Archivo Drive'],
    color: 'accent'
  },
  {
    id: 'servicios',
    industry: 'Servicios & Campo',
    title: 'Reportes de campo → facturación el mismo día',
    desc: 'Empresa de mantenimiento con 12 técnicos. Reportes en papel que llegaban 15 días después. Ahora la app de campo genera el reporte y la factura al instante.',
    savings: '~45h/mes',
    metric: '15 días → mismo día',
    robo: '0 reportes perdidos',
    tech: ['App campo', 'PDF auto', 'WhatsApp', 'Facturación DIAN'],
    color: 'brand'
  },
  {
    id: 'restaurantes',
    industry: 'Restaurantes & Delivery',
    title: 'Reservas, pedidos y pagos atendidos por IA',
    desc: '3 sedes con teléfonos saturados y 40% de llamadas perdidas. Un agente de IA atiende reservas y pedidos, y el pago llega por link Nequi. Todo integrado.',
    savings: '~75h/mes',
    metric: '40% perdidas → 2%',
    robo: '+18% ticket promedio',
    tech: ['Agente IA', 'Twilio', 'WhatsApp', 'Nequi'],
    color: 'accent'
  },
  {
    id: 'logistica',
    industry: 'Logística & Distribución',
    title: 'Tracking de guías y avisos automáticos',
    desc: 'Distribuidor que enviaba correos manuales con cada estado del envío. Ahora el robot sigue cada guía y notifica al cliente en cada etapa, sin tocar nada.',
    savings: '~30h/mes',
    metric: '0 avisos manuales',
    robo: '100% clientes informados',
    tech: ['RPA', 'APIs transportadoras', 'Email/WhatsApp'],
    color: 'brand'
  },
  {
    id: 'salud',
    industry: 'Salud & Laboratorio',
    title: 'Agendamiento de citas y recordatorios',
    desc: 'Consultorio que perdía el 25% de sus citas por inasistencia. Recordatorios automáticos por WhatsApp + lista de espera inteligente llenan las agendas.',
    savings: '~40h/mes',
    metric: '25% → 6% inasistencia',
    robo: 'Lista de espera auto',
    tech: ['RPA', 'WhatsApp', 'Agenda', 'Recordatorios'],
    color: 'brand'
  }
] as const;
---

<section id="casos" class="section-lg bg-[var(--bg-muted)]" aria-labelledby="casos-title">
  <div class="container">
    <header class="text-center mb-16 lg:mb-20 reveal slide-up">
      <span class="section-label">Casos por industria</span>
      <h2 id="casos-title" class="display-md text-[var(--text)] mb-6">Automatización real, resultados medidos</h2>
      <p class="body-lg max-w-2xl mx-auto">Cada industria tiene procesos repetitivos que se pueden automatizar. Estos son los patrones que repetimos con éxito en MIPYMEs de Bogotá y Cundinamarca.</p>
    </header>

    <div class="grid-auto">
      {cases.map((c, i) => (
        <article class="card card-elevated reveal slide-up stagger-1" style="animation-delay: {100 + i * 150}ms;">
          <div class="flex flex-col h-full">
            <div class="flex items-start justify-between gap-4 mb-4">
              <span class={`tag tag-${c.color}`}>{c.industry}</span>
              <svg class="w-6 h-6 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <h3 class="heading-md text-[var(--text)] mb-3">{c.title}</h3>
            <p class="body text-[var(--text-secondary)] mb-6">{c.desc}</p>

            <div class="grid grid-cols-2 gap-3 mb-6">
              <div class="p-3 bg-[var(--bg-muted)] border border-[var(--border)] rounded-lg text-center">
                <div class="heading-sm text-[var(--brand)]">{c.savings}</div>
                <div class="caption text-[var(--text-muted)]">Ahorro estimado</div>
              </div>
              <div class="p-3 bg-[var(--brand-bg)] border border-[var(--brand-border)] rounded-lg text-center">
                <div class="heading-sm text-[var(--brand-dark)]">{c.metric}</div>
                <div class="caption text-[var(--text-muted)]">Antes → después</div>
              </div>
            </div>

            <div class="mb-6">
              <div class="caption text-[var(--text-muted)] mb-2">Resultado clave</div>
              <p class="body-sm text-[var(--text-secondary)] flex items-center gap-2">
                <svg class="w-4 h-4 text-[var(--success)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                {c.robo}
              </p>
            </div>

            <div class="flex flex-wrap gap-2 mb-6">
              {c.tech.map(t => <span class="tag tag-neutral">{t}</span>)}
            </div>

            <a href="#procesos" class="btn btn-secondary btn-full mt-auto">Automatizar algo así</a>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center mt-16 lg:mt-20 reveal slide-up">
      <div class="p-8 lg:p-12 bg-[var(--bg-elevated)] border border-[var(--border)] rounded-2xl max-w-3xl mx-auto">
        <h3 class="heading-lg text-[var(--text)] mb-4">¿Tu caso podría estar aquí el próximo trimestre?</h3>
        <p class="body text-[var(--text-secondary)] mb-6 max-w-xl mx-auto">Empezamos con un diagnóstico de 30 minutos (gratis). Identificamos 3 quick-wins, te damos hoja de ruta y presupuesto. Sin compromiso.</p>
        <a href="#contacto" class="btn btn-primary btn-lg inline-flex">Mi diagnóstico gratis</a>
      </div>
    </div>
  </div>
</section>