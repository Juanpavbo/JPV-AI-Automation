---
const bookings = [
  { icon: 'Zap', title: 'Diagnóstico rápido', time: '15 min', desc: 'Conozco tu caso y te doy una visión inicial', color: 'brand-cyan' },
  { icon: 'MessageSquare', title: 'Consulta completa', time: '30 min', desc: 'Revisión a detalle y hoja de ruta', color: 'brand-pink' },
  { icon: 'Briefcase', title: 'Proyecto nuevo', time: '45 min', desc: 'Alcance, presupuesto y plan de trabajo', color: 'brand-cyan' }
] as const;

const icons = {
  Zap: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>',
  MessageSquare: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>',
  Briefcase: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>'
};

const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL || 'https://calendly.com/tu-usuario';
---

<section id="agendar" class="py-20 md:py-28" style="background: radial-gradient(ellipse at 50% 50%, rgba(0,212,255,.04) 0%, transparent 50%);">
  <div class="container">
    <div class="section-label mb-3 inline-block">Agenda una cita</div>
    <h2 class="section-title text-3xl md:text-4xl font-bold mb-4">Conversemos sin compromiso</h2>
    <p class="section-desc text-gray-400 max-w-2xl mb-12">Elige el tipo de reunión y el horario que mejor se ajuste a ti. Por videollamada o presencial en Bogotá.</p>

    <div class="booking-grid grid lg:grid-cols-2 gap-12 items-start">
      <div>
        <div class="booking-info">
          <p class="text-gray-400 mb-6 text-base leading-relaxed">
            Una llamada de 15-30 minutos basta para entender tu situación, identificar oportunidades y definir si puedo ayudarte. Sin presiones, sin contratos.
          </p>
          <div class="booking-types flex flex-col gap-4">
            {bookings.map((booking) => (
              <div class="booking-type p-4 rounded-xl transition-all duration-200" style="background: #12121a; border: 1px solid rgba(0,212,255,.1);">
                <div class="flex items-center gap-4">
                  <div class="bt-icon p-2 rounded-lg" style="color: var(--color-{booking.color}); background: rgba(0,212,255,.1);" set:html={icons[booking.icon]}></div>
                  <div class="bt-info">
                    <h4 class="font-medium">{booking.title}</h4>
                    <span class="text-sm text-gray-500">{booking.time} • {booking.desc}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div id="calendly-inline" class="calendly-placeholder rounded-2xl p-8 md:p-12 text-center min-h-[400px] flex flex-col items-center justify-center" style="background: #12121a; border: 1px solid rgba(0,212,255,.1);">
        <div class="cp-icon text-5xl mb-4" style="color: #00d4ff;">📅</div>
        <h3 class="text-xl font-semibold mb-2">Agenda tu llamada</h3>
        <p class="text-gray-500 text-sm max-w-xs mb-6">
          Elige un horario en mi calendario y recibirás la confirmación por correo al instante.
        </p>
        <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary mb-4">Abrir calendario →</a>
        <p class="text-xs text-gray-600">Videollamada por Google Meet o presencial en Bogotá.</p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .calendly-placeholder { min-height: 400px; }
</style>