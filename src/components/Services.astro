---
const services = [
  {
    id: 'automatizacion',
    icon: 'Zap',
    title: 'Automatización Inteligente',
    shortDesc: 'Eliminamos tareas repetitivas y conectamos tus sistemas.',
    fullDesc: 'Diseñamos e implementamos flujos de trabajo automatizados que eliminan el trabajo manual: descargas de bancos, conciliaciones, envío de correos, generación de documentos, sincronización entre ERP/CRM/Contabilidad. Usamos n8n, Power Automate, RPA y OCR para que tus datos fluyan solos.',
    industries: [
      { name: 'Comercio/Retail', example: 'Conciliación diaria Nequi/Daviplata vs. POS vs. Bancos → 0 errores, 3h/día ahorradas' },
      { name: 'Contabilidad', example: 'Descarga automática bancaria → contabilidad → conciliación bancaria automática' },
      { name: 'Logística', example: 'Tracking automático guías → notificación cliente → actualización ERP' },
      { name: 'Servicios', example: 'Facturación recurrente → envío email + WhatsApp → conciliación pago' }
