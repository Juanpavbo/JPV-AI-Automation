      { name: 'Manufactura', example: 'OEE tiempo real → paradas no planificadas → alerta mantenimiento predictivo' },
      { name: 'Profesionales', example: 'Rentabilidad por cliente/proyecto → alerta proyectos en pérdida' }
    ],
    tech: ['Power BI', 'Looker Studio', 'Python', 'SQL', 'Databricks', 'ETL automatizado'],
    color: 'brand'
  },
  {
    id: 'ia',
    icon: 'Bot',
    title: 'Agentes de IA & LLMs',
    shortDesc: 'Agentes que leen, clasifican, responden y ejecutan tareas 24/7.',
    fullDesc: 'Creamos agentes de IA que se integran a tu operación: clasificación automática de emails/documentos, respuesta a consultas frecuentes, extracción de datos de PDFs/facturas/contratos, generación de propuestas/cotizaciones, análisis de contratos/riesgos. Modelos: Claude, GPT-4, DeepSeek, Ollama (local). Privacidad: opción 100% on-premise.',
    industries: [
      { name: 'Legal/Contable', example: 'Agente lee contratos → extrae cláusulas clave → alerta riesgos → resumen ejecutivo' },
      { name: 'Atención cliente', example: 'Agente responde FAQs → escala complejo a humano → registra en CRM' },
      { name: 'Compras/Proveedores', example: 'Agente lee facturas PDF → extrae datos → valida contra OC → contabiliza' },
      { name: 'RRHH', example: 'Agente filtra CVs → ranking vs. requisitos → agenda entrevistas' }
    ],
    tech: ['Claude', 'GPT-4', 'DeepSeek', 'Ollama', 'MCP', 'RAG', 'Vector DB'],
    color: 'accent'
  },
  {
    id: 'lowcode',
    icon: 'LayoutGrid',
    title: 'Low-Code / No-Code',
    shortDesc: 'Apps y flujos sin programar: Power Apps, Copilot Studio, n8n.',
    fullDesc: 'Construimos aplicaciones de negocio sin código pesado: formularios inteligentes, portales de clientes/proveedores, aprobadores de gastos/vacaciones/compras, dashboards operativos, formularios de campo offline. Mantenibles por tu equipo, escalables, integrados a tus datos.',
    industries: [
      { name: 'RRHH', example: 'Portal solicitudes vacaciones/gastos → aprobación jerárquica → nómina automática' },
