---
const services = [
  { icon: 'Zap', title: 'Automatización Inteligente', desc: 'n8n, Power Automate, RPA, OCR y MCP para eliminar tareas repetitivas y conectar sistemas.', tags: ['n8n', 'Power Automate', 'RPA', 'OCR'] },
  { icon: 'BarChart', title: 'Analítica & BI', desc: 'Power BI, Databricks, Python, Spark y SQL. Datos dispersos convertidos en decisiones.', tags: ['Power BI', 'Databricks', 'Python', 'SQL'] },
  { icon: 'Bot', title: 'Agentes de IA & LLMs', desc: 'Agentes con Claude, OpenAI, DeepSeek, Ollama y MCP integrados en procesos empresariales.', tags: ['Claude', 'ChatGPT', 'DeepSeek', 'Ollama'] },
  { icon: 'Layout', title: 'Low-Code / No-Code', desc: 'Power Apps, Copilot Studio, Power Automate, n8n. Automatización sin programar.', tags: ['Power Apps', 'Copilot Studio', 'Power Automate'] },
  { icon: 'Cloud', title: 'Cloud & DevOps', desc: 'Azure, Docker, SQL Server, MongoDB. Infraestructura escalable y segura.', tags: ['Azure', 'Docker', 'SQL Server', 'MongoDB'] },
  { icon: 'Cpu', title: 'ERP & Optimización', desc: 'Automatización SAP Ariba, SAP ERP, integración con Oracle, Power BI y SharePoint.', tags: ['SAP Ariba', 'SAP ERP', 'Oracle', 'SharePoint'] },
  { icon: 'Shield', title: 'Validación de Pagos Nequi/Daviplata', desc: 'Automatización anti-fraude: webhooks, conciliación en tiempo real, detección de transacciones sospechosas y garantía de legitimidad en billeteras digitales.', tags: ['Wompi', 'Webhooks', 'Conciliación', 'Anti-fraude'] }
] as const;

const icons = {
  Zap: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>',
  BarChart: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>',
  Bot: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>',
  Layout: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>',
  Cloud: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>',
  Cpu: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" /></svg>',
  Shield: '<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>'
};
---

<section id="servicios" class="py-20 md:py-28">
  <div class="container">
    <div class="section-label mb-3 inline-block">Servicios</div>
    <h2 class="section-title text-3xl md:text-4xl font-bold mb-4">Lo que hago</h2>
    <p class="section-desc text-gray-400 max-w-2xl mb-12">Consultoría integral en transformación digital, desde el diagnóstico hasta la implementación, para empresas y profesionales.</p>
    <div class="services-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service) => (
        <div class="service-card p-8 transition-all duration-300" style="background: linear-gradient(145deg, #12121a, #0e0e15); border: 1px solid rgba(0,212,255,.1); border-radius: 1rem;">
          <div class="service-icon text-brand-cyan mb-4" set:html={icons[service.icon]}></div>
          <h3 class="text-xl font-semibold mb-3">{service.title}</h3>
          <p class="text-gray-500 text-sm mb-4">{service.desc}</p>
          <div class="service-tags flex flex-wrap gap-2">
            {service.tags.map((tag) => (
              <span class="px-3 py-1 rounded-full text-xs font-medium" style="background: rgba(0,212,255,.08); color: #00d4ff;">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .service-card:hover { border-color: rgba(0,212,255,.3); transform: translateY(-4px); }
</style>