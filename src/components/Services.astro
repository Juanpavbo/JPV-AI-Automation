    industries: [
      { name: 'Comercio/Retail', example: 'Validación 500+ transacciones/día Nequi/Daviplata → 0 conciliación manual, 0 fraudes' },
      { name: 'Restaurantes/Delivery', example: 'Validación pago QR mesa → confirmación cocina automática → ticket impreso' },
      { name: 'E-commerce', example: 'Validación pago link → confirmación pedido → envío automático guía' },
      { name: 'Servicios profesionales', example: 'Validación pago honorarios → factura automática → conciliación contable' }
