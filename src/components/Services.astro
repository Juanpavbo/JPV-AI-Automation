---

<section id="servicios" class="section-lg" aria-labelledby="servicios-title">
  <div class="container">
    <header class="text-center mb-16 lg:mb-20 reveal slide-up">
      <span class="section-label">Servicios</span>
      <h2 id="servicios-title" class="display-md text-[var(--text)] mb-6">Servicios diseñados para MIPYMEs que quieren operar sin fricción</h2>
      <p class="body-lg max-w-2xl mx-auto">Cada servicio incluye diagnóstico, implementación, capacitación y acompañamiento. Eliges lo que necesitas, escalamos juntos.</p>
    </header>

    <div class="grid-auto">
      {services.map((service, i) => (
        <article class="card card-elevated reveal slide-up stagger-1" style="animation-delay: {100 + i * 100}ms;">
          <div class="flex flex-col h-full">
            <!-- Header -->
            <div class="flex items-start gap-4 mb-6">
              <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-[var(--{service.color}-bg)] border border-[var(--{service.color}-border)] flex items-center justify-center text-[var(--{service.color}-dark)]" set:html={icons[service.icon]} />
              <div class="flex-1">
                <span class="caption text-[var(--{service.color}-dark)]">{service.id.charAt(0).toUpperCase() + service.id.slice(1).replace('-', ' ')}</span>
                <h3 class="heading-md text-[var(--text)] mt-1">{service.title}</h3>
              </div>
            </div>
            
            <!-- Short description -->
            <p class="body text-[var(--text-secondary)] mb-6">{service.shortDesc}</p>
            
            <!-- Expandable details -->
            <details class="group mb-6">
              <summary class="flex items-center justify-between cursor-pointer text-sm font-medium text-[var(--brand)] hover:text-[var(--brand-dark)] transition-colors">
                <span>Ver detalles y casos por industria</span>
                <svg class="w-5 h-5 text-[var(--text-muted)] transition-transform duration-300 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="mt-4 p-4 bg-[var(--bg-muted)] rounded-lg space-y-4 animate-in">
                <p class="body text-[var(--text-secondary)]">{service.fullDesc}</p>
                <div>
                  <h4 class="heading-sm text-[var(--text)] mb-3">Casos reales por industria</h4>
                  <div class="grid gap-3 sm:grid-cols-2">
                    {service.industries.map(ind => (
                      <div class="p-3 bg-[var(--bg-elevated)] border border-[var(--border)] rounded-lg">
                        <span class="caption text-[var(--brand-dark)]">{ind.name}</span>
                        <p class="body-sm text-[var(--text-secondary)] mt-1">{ind.example}</p>
                      </div>
                    ))}
                  </div>
                </div>
                <div class="flex flex-wrap gap-2">
                  {service.tech.map(t => <span class="tag tag-neutral">{t}</span>)}
                </div>
              </div>
            </details>
            
            <!-- CTA -->
            <a href="#contacto" class="btn btn-primary btn-full mt-auto">
              Solicitar propuesta para {service.title.toLowerCase()}
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA Global -->
    <div class="text-center mt-16 lg:mt-20 reveal slide-up">
      <p class="body text-[var(--text-secondary)] mb-4 max-w-xl mx-auto">¿Necesitas combinar varios servicios? Diseñamos un plan a tu medida.</p>
      <a href="#contacto" class="btn btn-primary btn-lg inline-flex">Diseñar mi plan</a>
    </div>
  </div>
</section>

<style>
  details > summary { list-style: none; cursor: pointer; }
  details > summary::-webkit-details-marker { display: none; }
  details[open] > summary { color: var(--brand-dark); }
  details > summary::marker { display: none; }
</style>