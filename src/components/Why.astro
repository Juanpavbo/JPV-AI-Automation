---
const pains = [
  { icon: 'FileText', title: 'Tareas repetitivas', desc: 'Descargas manuales, cruces en Excel, copiar y pegar entre sistemas. Horas que podrías recuperar.' },
  { icon: 'BarChart', title: 'Reportes diarios', desc: 'Generar el mismo informe una y otra vez. Que se autogenere y llegue a tu bandeja cada mañana.' },
  { icon: 'Database', title: 'Cruces de datos', desc: 'Conciliar bases, validar información entre sistemas, detectar inconsistencias en segundos.' },
  { icon: 'Bell', title: 'Seguimientos y Alertas', desc: 'Vencer fechas, aprobaciones pendientes, cambios críticos. Alertas automáticas antes de que sea tarde.' },
  { icon: 'FolderOpen', title: 'Datos sin orden', desc: 'Información en correos, carpetas compartidas, chats. Un tablero que unifique todo.' },
  { icon: 'FileSearch', title: 'Documentación dispersa', desc: 'Versiones de archivos por todos lados, procesos no documentados, pérdida de conocimiento.' }
] as const;

const icons = {
  FileText: () => <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>,
  BarChart: () => <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>,
  Database: () => <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" /></svg>,
  Bell: () => <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>,
  FolderOpen: () => <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>,
  FileSearch: () => <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
};
---

<section id="porque" class="py-20 md:py-28 relative" style="background: radial-gradient(ellipse at 50% 50%, rgba(255,0,110,.04) 0%, transparent 50%);">
  <div class="container">
    <div class="section-label mb-3 inline-block">Por qué automatizar</div>
    <h2 class="section-title text-3xl md:text-4xl font-bold mb-4">Te suena familiar?</h2>
    <p class="section-desc text-gray-400 max-w-2xl mb-12">Tareas que consumen horas, datos dispersos, reportes a última hora. No tiene que ser así.</p>
    <div class="pain-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {pains.map((pain) => (
        <div class="pain-card p-7 text-center transition-all duration-300" style="background: linear-gradient(145deg, #12121a, #0e0e15); border: 1px solid rgba(255,0,110,.12); border-radius: 1rem;">
          <div class="pain-icon text-brand-pink mb-3 flex justify-center">{icons[pain.icon]()}</div>
          <h3 class="text-lg font-semibold mb-2">{pain.title}</h3>
          <p class="text-gray-500 text-sm">{pain.desc}</p>
        </div>
      ))}
    </div>
    <div class="pain-result mt-10 text-center p-8 rounded-2xl" style="background: linear-gradient(135deg, rgba(0,212,255,.06), rgba(255,0,110,.06)); border: 1px solid rgba(0,212,255,.15);">
      <h3 class="text-xl md:text-2xl font-bold mb-3">Imagina que todo eso simplemente... funcione solo</h3>
      <p class="text-gray-400 text-base max-w-2xl mx-auto">Automatizaciones que ejecutan tareas, agentes de IA que monitorean y alertan, tableros que se actualizan solos, y procesos que fluyen sin intervención manual. Eso es lo que construyo.</p>
    </div>
  </div>
</section>

<style is:global>
  .section-label { padding: 4px 14px; border-radius: 12px; background: rgba(0,212,255,.1); color: #00d4ff; font-size: .8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
  .section-title { font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; }
  .section-desc { color: #a0a0b0; max-width: 600px; }
  .pain-card:hover { border-color: rgba(255,0,110,.3); transform: translateY(-4px); }
</style>