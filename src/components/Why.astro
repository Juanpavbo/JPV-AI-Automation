---
const pains = [
  {
    icon: 'ClipboardList',
    title: 'Conciliación manual de pagos',
    industry: 'Comercio / Retail',
    desc: 'Cada día concilias manualmente ventas Nequi/Daviplata vs. extractos bancarios. Errores humanos, tiempo perdido, fugas de dinero.',
    metric: '~3-5h/día perdidas'
  },
  {
    icon: 'FileText',
    title: 'Correos corporativos sin activar',
    industry: 'Servicios profesionales',
    desc: 'Tienes dominio propio pero usas @gmail/@hotmail. Pierdes credibilidad, no cumples normativa, pierdes clientes corporativos.',
    metric: '70% MIPYMEs sin correo corporativo'
  },
  {
    icon: 'FileSpreadsheet',
    title: 'Reportes manuales en Excel',
    industry: 'Contabilidad / Finanzas',
    desc: 'Cada mes repites el mismo proceso: descargar, copiar, pegar, formatear. Errores de copiar/pegar, versión equivocada, entrega tarde.',
    metric: '8-16h/mes en reportes'
  },
  {
    icon: 'Users',
    title: 'Seguimiento de clientes en WhatsApp/Notas',
    industry: 'Servicios / Consultoría',
    desc: 'Leads en WhatsApp, notas en papel, seguimiento en la memoria. Oportunidades perdidas, seguimientos olvidados, pipeline invisible.',
    metric: '30-40% leads sin seguimiento'
  },
  {
    icon: 'Clock',
    title: 'Facturación y cobro manual',
    industry: 'Servicios / Mantenimiento',
    desc: 'Generar facturas una a una, enviar por WhatsApp, cobrar por transferencia, conciliar manualmente. Ciclo de cobro > 45 días.',
    metric: 'Ciclo cobro 45-60 días'
  },
  {
    icon: 'Shield',
    title: 'Validación de pagos Nequi/Daviplata',
    industry: 'Todos los sectores',
    desc: 'Recibes pagos por billeteras pero no validas en tiempo real. Fraude, pagos rechazados, conciliación posterior lenta y propensa a errores.',
    metric: '5-15% pagos con problemas'
  }
] as const;

const icons = {
  ClipboardList: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5l2 2M9 5l-2 2M15 19l-7-7 7-7"/></svg>',
  FileText: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>',
  FileSpreadsheet: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M3 14h18m-9-4v8m-7 0h18"/></svg>',
  Users: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>',
  Clock: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
  Shield: '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>'
} as const;
---

<section id="porque" class="section relative overflow-hidden" aria-labelledby="porque-title">
  <!-- Background decoration -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-[var(--brand)]/5 rounded-full blur-[150px] translate-x-1/2 -translate-y-1/2" />
    <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-[var(--accent)]/5 rounded-full blur-[120px] -translate-x-1/2 translate-y-1/2" />
  </div>

  <div class="container relative z-10">
    <header class="text-center mb-16 lg:mb-20 reveal slide-up">
      <span class="section-label">Por qué automatizar</span>
      <h2 id="porque-title" class="display-md text-[var(--text)] mb-6">Dolores que toda MIPYME en Bogotá y Cundinamarca conoce</h2>
      <p class="body-lg max-w-2xl mx-auto">No son problemas únicos. Son patrones que vemos cada día en comercio, servicios, contabilidad y retail. La diferencia: los resolvemos con automatización que funciona 24/7.</p>
    </header>

    <div class="grid-auto reveal slide-up stagger-1" style="animation-delay: 100ms;">
      {pains.map((pain, i) => (
        <article class="card card-interactive group reveal slide-up" style="animation-delay: {100 + i * 100}ms;">
          <div class="flex flex-col h-full">
            <div class="flex items-start gap-4 mb-6">
              <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-[var(--brand-bg)] border border-[var(--brand-border)] flex items-center justify-center text-[var(--brand-dark)]" set:html={icons[pain.icon]} />
              <div>
                <span class="caption text-[var(--brand-dark)]">{pain.industry}</span>
                <h3 class="heading-md text-[var(--text)] mt-1">{pain.title}</h3>
              </div>
            </div>
            <p class="body text-[var(--text-secondary)] mb-4 flex-1">{pain.desc}</p>
            <div class="flex items-center justify-between pt-4 border-t border-[var(--border)]">
              <span class="tag tag-brand">{pain.metric}</span>
              <span class="text-sm text-[var(--text-muted)] group-hover:text-[var(--brand)] transition-colors">Ver solución →</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-16 lg:mt-20 reveal slide-up stagger-7" style="animation-delay: 700ms;">
      <p class="body text-[var(--text-secondary)] mb-4 max-w-xl mx-auto">¿Te identificaste con 2 o más? Hablemos de cómo automatizarlo esta semana.</p>
      <a href="#contacto" class="btn btn-primary btn-lg inline-flex">Agendar diagnóstico gratis</a>
    </div>
  </div>
</section>

<style>
  @media (max-width: 640px) {
    .grid-auto { grid-template-columns: 1fr; }
  }
</style>