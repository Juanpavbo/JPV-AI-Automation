---
interface Props {
  username?: string;
  welcomeMessage?: string;
  className?: string;
}
const {
  username = 'vexania_bot',
  welcomeMessage = 'Hola 👋 ¿En qué puedo ayudarte?',
  className = ''
} = Astro.props;

const telegramUrl = `https://t.me/${username}?start=${encodeURIComponent(welcomeMessage)}`;
---

<a
  id="vex-telegram-float"
  href={telegramUrl}
  target="_blank"
  rel="noopener noreferrer"
  class={`vex-telegram-float ${className}`}
  aria-label="Contactar por Telegram"
  title="Escríbenos por Telegram"
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
    <path d="M15 9h.01M10 9h.01M15 14h.01M10 14h.01" />
  </svg>
  <span class="vex-telegram-tooltip">Telegram</span>
</a>

<style>
  .vex-telegram-float {
    position: fixed;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    border: none;
    cursor: pointer;
    color: #fff;
    background: linear-gradient(135deg, #0088cc, #006699);
    box-shadow: 0 8px 24px rgba(0, 136, 204, 0.35);
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .vex-telegram-float:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0, 136, 204, 0.45);
  }
  .vex-telegram-float:focus-visible {
    outline: 2px solid #00d4ff;
    outline-offset: 2px;
  }
  .vex-telegram-tooltip {
    position: absolute;
    left: calc(100% + 0.5rem);
    bottom: 50%;
    transform: translateY(50%);
    padding: 0.35rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    background: #0a0a0f;
    color: #e0e0e0;
    border: 1px solid rgba(0, 212, 255, 0.2);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }
  .vex-telegram-float:hover .vex-telegram-tooltip {
    opacity: 1;
  }
  @media (max-width: 640px) {
    .vex-telegram-float {
      width: 3rem;
      height: 3rem;
    }
    .vex-telegram-tooltip {
      display: none;
    }
  }
</style>